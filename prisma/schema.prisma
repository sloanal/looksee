// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // hashed password
  imageUrl  String?
  createdAt DateTime @default(now())

  roomMemberships     RoomMembership[]
  mediaItems          MediaItem[]           @relation("CreatedBy")
  preferences         UserMediaPreference[]
  addedToRooms        MediaItemRoom[]       @relation("AddedToRoom")
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
}

model Room {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  memberships    RoomMembership[]
  mediaItems     MediaItem[]
  mediaItemRooms MediaItemRoom[]
}

model RoomMembership {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  role      String   @default("member") // "owner" or "member"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId])
  @@index([userId])
}

model MediaItem {
  id              String   @id @default(cuid())
  roomId          String? // LEGACY: pre-join-table "original room". Not membership; never written or read. Use MediaItemRoom.
  title           String
  type            String // MOVIE, SHOW, VIDEO, LINK
  tmdbId          String?
  sourceType      String // TMDB, MANUAL
  externalUrl     String?
  posterUrl       String?
  description     String?
  genres          String // JSON array stored as string
  runtimeMinutes  Int?
  rating          Float? // TMDB rating (vote_average)
  releaseDate     String? // Release date from TMDB
  createdByUserId String
  createdAt       DateTime @default(now())

  room           Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation("CreatedBy", fields: [createdByUserId], references: [id])
  preferences    UserMediaPreference[]
  mediaItemRooms MediaItemRoom[]

  @@index([roomId])
  @@index([createdByUserId])
  @@index([tmdbId])
}

model UserMediaPreference {
  id                    String    @id @default(cuid())
  userId                String
  mediaItemId           String
  status                String // HAVE_NOT_SEEN, ALREADY_SEEN
  isWatched             Boolean   @default(false)
  isFavorite            Boolean   @default(false)
  excitement            Int // 1, 3, or 5 (Not excited, Neutral, Excited)
  notes                 String?
  recommendedByName     String?
  recommendationContext String?
  updatedAt             DateTime  @default(now())
  // When the user last rated (status/excitement/watched). Null = a placeholder
  // row (e.g. favorite-only) that must still count as "unrated" for the queue.
  ratedAt               DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaItemId])
  @@index([userId])
  @@index([mediaItemId])
  @@index([status])
  @@index([isWatched])
  @@index([userId, isFavorite])
}

model MediaItemRoom {
  id            String   @id @default(cuid())
  mediaItemId   String
  roomId        String
  addedByUserId String // Track who added this item to this room
  createdAt     DateTime @default(now())
  // Per-room submission context: { timezone?, locale?, submittedAt } (server-stamped, no geolocation).
  sourceMeta    Json?

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  addedBy   User      @relation("AddedToRoom", fields: [addedByUserId], references: [id])

  @@unique([mediaItemId, roomId])
  @@index([mediaItemId])
  @@index([roomId])
  @@index([addedByUserId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
